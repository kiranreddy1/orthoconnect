# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# ---- Database (Azure Database for PostgreSQL Flexible Server) ----
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgres://orthoconnect_admin:CHANGE_ME@oc-pg-prod-eastus.postgres.database.azure.com:5432/orthoconnect?sslmode=require

# ---- Email (Resend, swappable) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@orthoconnect.care
EMAIL_PROVIDER=resend

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Azure (used by infra scripts, not the app) ----
AZURE_SUBSCRIPTION_ID=e645cfef-1c75-42e7-95b6-fe74fd188d24
AZURE_TENANT_ID=808770ab-848d-4380-bcf2-e394096bc18f
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=oc-rg-prod-eastus
